<?xml version="1.0" encoding="utf-8"?>

<resources>

    <declare-styleable name="DoraTextEditor">

        <!-- Toolbar -->
        <attr name="dview_te_toolbarVisible" format="boolean" />

        <attr name="dview_te_toolbarHeight" format="dimension|reference" />

        <attr name="dview_te_toolbarColor" format="color|reference" />

        <!-- Editor -->
        <attr name="dview_te_textColor" format="color|reference" />

        <attr name="dview_te_hintColor" format="color|reference" />

        <attr name="dview_te_hint" format="string|reference" />

        <attr name="dview_te_textSize" format="dimension|reference" />

        <!-- Divider -->
        <attr name="dview_te_dividerColor" format="color|reference" />

        <!-- Behavior -->
        <attr name="dview_te_spellCheck" format="boolean" />

        <attr name="dview_te_wordWrap" format="boolean" />

        <attr name="dview_te_justify" format="boolean" />

    </declare-styleable>

</resources>